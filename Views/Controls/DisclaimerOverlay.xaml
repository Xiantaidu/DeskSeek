<UserControl x:Class="DeskSeek.Views.Controls.DisclaimerOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#FFFFFF">
    <Grid Margin="24,18,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header with Icon and Title -->
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="38" Height="38" CornerRadius="19" Background="#EFF6FF" Margin="0,0,10,0">
                    <TextBlock Text="🛡️" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource Lang_DisclaimerTitle}" FontSize="16" FontWeight="Bold" Foreground="#0F172A"/>
                    <TextBlock Text="{DynamicResource Lang_DisclaimerSubtitle}" FontSize="11" Foreground="#64748B" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>
        </StackPanel>

        <!-- Scrollable Terms Content -->
        <Border Grid.Row="1"
                Background="#F8FAFC"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                CornerRadius="10"
                Padding="16,14">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Lang_DisclaimerSec1Title}" FontSize="12.5" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,4"/>
                    <TextBlock Text="{DynamicResource Lang_DisclaimerSec1Content}"
                               FontSize="11.5" Foreground="#475569" TextWrapping="Wrap" LineHeight="18" Margin="0,0,0,12"/>

                    <TextBlock Text="{DynamicResource Lang_DisclaimerSec2Title}" FontSize="12.5" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,4"/>
                    <TextBlock Text="{DynamicResource Lang_DisclaimerSec2Content}"
                               FontSize="11.5" Foreground="#475569" TextWrapping="Wrap" LineHeight="18" Margin="0,0,0,12"/>

                    <TextBlock Text="{DynamicResource Lang_DisclaimerSec3Title}" FontSize="12.5" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,4"/>
                    <TextBlock Text="{DynamicResource Lang_DisclaimerSec3Content}"
                               FontSize="11.5" Foreground="#475569" TextWrapping="Wrap" LineHeight="18" Margin="0,0,0,12"/>

                    <TextBlock Text="{DynamicResource Lang_DisclaimerSec4Title}" FontSize="12.5" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,4"/>
                    <TextBlock Text="{DynamicResource Lang_DisclaimerSec4Content}"
                               FontSize="11.5" Foreground="#475569" TextWrapping="Wrap" LineHeight="18"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Actions Area -->
        <StackPanel Grid.Row="2" Margin="0,14,0,0">
            <!-- CheckBox -->
            <CheckBox x:Name="DisclaimerCheckBox"
                      IsEnabled="False"
                      Margin="2,0,0,12"
                      Cursor="Hand"
                      Click="DisclaimerCheckBox_Click">
                <TextBlock Text="{DynamicResource Lang_DisclaimerCheck}"
                           FontSize="12"
                           FontWeight="Medium"
                           Foreground="#334155"
                           VerticalAlignment="Center"/>
            </CheckBox>

            <!-- Confirm Button -->
            <Button x:Name="DisclaimerAgreeButton"
                    Height="40"
                    IsEnabled="False"
                    Background="#94A3B8"
                    Foreground="#FFFFFF"
                    FontSize="13"
                    FontWeight="SemiBold"
                    BorderThickness="0"
                    Cursor="No"
                    Click="DisclaimerAgreeButton_Click">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="8"/>
                    </Style>
                </Button.Resources>
                <TextBlock x:Name="DisclaimerButtonText"
                           Text="请先阅读免责声明 (3s)"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
