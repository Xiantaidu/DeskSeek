<Window x:Class="DeskSeek.Views.FloatingBallWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeskSeek Ball"
        Icon="/Assets/logo.png"
        Height="96" Width="96"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        MouseEnter="Window_MouseEnter"
        MouseLeave="Window_MouseLeave"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        MouseLeftButtonUp="Window_MouseLeftButtonUp"
        MouseMove="Window_MouseMove"
        PreviewMouseRightButtonDown="Window_PreviewMouseRightButtonDown">

    <Window.Resources>
        <!-- Fluid spring scale transformation for hover effect -->
        <Storyboard x:Key="OnMouseEnterStory">
            <DoubleAnimation Storyboard.TargetName="BallScale"
                             Storyboard.TargetProperty="ScaleX"
                             To="1.10" Duration="0:0:0.26">
                <DoubleAnimation.EasingFunction>
                    <BackEase Amplitude="0.35" EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="BallScale"
                             Storyboard.TargetProperty="ScaleY"
                             To="1.10" Duration="0:0:0.26">
                <DoubleAnimation.EasingFunction>
                    <BackEase Amplitude="0.35" EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
        <Storyboard x:Key="OnMouseLeaveStory">
            <DoubleAnimation Storyboard.TargetName="BallScale"
                             Storyboard.TargetProperty="ScaleX"
                             To="1.0" Duration="0:0:0.22">
                <DoubleAnimation.EasingFunction>
                    <QuarticEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="BallScale"
                             Storyboard.TargetProperty="ScaleY"
                             To="1.0" Duration="0:0:0.22">
                <DoubleAnimation.EasingFunction>
                    <QuarticEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <!-- Modern Windows 11 ContextMenu Styling with Dynamic Theme -->
        <Style TargetType="ContextMenu">
            <Setter Property="Background" Value="{DynamicResource Theme_ContextMenuBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Theme_ContextMenuBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="MinWidth" Value="180"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="16" Color="#000000" Opacity="0.2" ShadowDepth="4" Direction="270"/>
                            </Border.Effect>
                            <StackPanel IsItemsHost="True"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Separator">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource Theme_ContextMenuSeparator}"/>
            <Setter Property="Margin" Value="4,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Height="1" Background="{DynamicResource Theme_ContextMenuSeparator}" Margin="4,3"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="MenuItem">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Foreground" Value="{DynamicResource Theme_ContextMenuText}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="ItemBorder"
                                CornerRadius="6"
                                Background="Transparent"
                                Padding="10,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="CheckMark"
                                           Grid.Column="0"
                                           Text="✓"
                                           FontWeight="Bold"
                                           FontSize="13"
                                           Foreground="{DynamicResource Theme_AccentBrush}"
                                           VerticalAlignment="Center"
                                           Visibility="Collapsed"/>
                                <ContentPresenter Grid.Column="1"
                                                  ContentSource="Header"
                                                  VerticalAlignment="Center"
                                                  Margin="4,0,8,0"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource Theme_ContextMenuHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Window.ContextMenu>
        <ContextMenu x:Name="BallContextMenu"
                     Opened="BallContextMenu_Opened"
                     Closed="BallContextMenu_Closed">
            <MenuItem x:Name="MenuToggleItem"
                      Header="显示 / 隐藏"
                      FontWeight="SemiBold"
                      Click="MenuToggle_Click"/>

            <Separator/>

            <MenuItem x:Name="MenuAutoStartItem"
                      Header="开机自启"
                      IsCheckable="True"
                      Click="MenuAutoStart_Click"/>

            <MenuItem x:Name="MenuPinTopmostItem"
                      Header="常驻且置顶"
                      IsCheckable="True"
                      Click="MenuPinTopmost_Click"/>

            <MenuItem x:Name="MenuPinNormalItem"
                      Header="常驻但不置顶"
                      IsCheckable="True"
                      Click="MenuPinNormal_Click"/>

            <MenuItem x:Name="MenuPinAutoHideItem"
                      Header="失焦自动收起"
                      IsCheckable="True"
                      Click="MenuPinAutoHide_Click"/>

            <Separator/>

            <MenuItem x:Name="MenuSettingsItem"
                      Header="偏好设置..."
                      Click="MenuSettings_Click"/>

            <MenuItem x:Name="MenuResetBallItem"
                      Header="重置悬浮球位置"
                      Click="MenuResetBall_Click"/>

            <MenuItem x:Name="MenuOpenBrowserItem"
                      Header="在浏览器中打开当前对话"
                      Click="MenuOpenBrowser_Click"/>

            <Separator/>

            <MenuItem x:Name="MenuExitItem"
                      Header="退出 DeskSeek"
                      Foreground="#DC2626"
                      Click="MenuExit_Click"/>
        </ContextMenu>
    </Window.ContextMenu>

    <Grid x:Name="RootGrid" Width="96" Height="96">
        <!-- Floating Mascot with spring hover scaling and soft glow shadow -->
        <Border x:Name="BallContainer"
                Width="76" Height="76"
                Cursor="Hand"
                Background="Transparent"
                RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <ScaleTransform x:Name="BallScale" ScaleX="1" ScaleY="1"/>
            </Border.RenderTransform>

            <Grid>
                <!-- Mascot Image with glowing ambient shadow -->
                <Image x:Name="MascotImage"
                       Source="/Assets/logo.png"
                       Width="74" Height="74"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       SnapsToDevicePixels="True">
                    <Image.Effect>
                        <DropShadowEffect x:Name="BallShadow"
                                          Color="{DynamicResource Theme_AccentGlowColor}"
                                          BlurRadius="14"
                                          Opacity="0.55"
                                          Direction="270"
                                          ShadowDepth="3"/>
                    </Image.Effect>
                </Image>
            </Grid>
        </Border>
    </Grid>
</Window>
