<Window x:Class="DeskSeek.Views.DrawerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="DeskSeek"
        Width="460" Height="800"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Deactivated="Window_Deactivated">

    <Window.Resources>
        <!-- Modern control button style -->
        <Style x:Key="HeaderBtnStyle" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="8" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#15000000"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#25000000"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Main Container: Crisp Modern Border and Rounded Corners (No blurry shadow) -->
    <Grid Margin="6">
        <Border x:Name="MainCard"
                CornerRadius="16"
                Background="#FFFFFF"
                BorderBrush="#CBD5E1"
                BorderThickness="1.2"
                RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <TranslateTransform x:Name="CardTranslate" X="0" Y="0"/>
            </Border.RenderTransform>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="50"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="16"/>
                </Grid.RowDefinitions>

                <!-- Header Bar -->
                <Border Grid.Row="0"
                        Background="#F8FAFC"
                        CornerRadius="16,16,0,0"
                        BorderBrush="#E2E8F0"
                        BorderThickness="0,0,0,1">
                    <Grid Margin="14,0,10,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Logo & Brand Title -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Mini whale logo -->
                            <Border Width="26" Height="26" CornerRadius="13" Background="#0052D9" Margin="0,0,8,0">
                                <Viewbox Width="16" Height="16">
                                    <Canvas Width="1024" Height="1024">
                                        <Path Fill="White" Data="M875 510 C830 380, 710 300, 560 290 C420 280, 290 350, 210 440 C170 485, 130 535, 90 570 C80 580, 70 595, 80 610 C90 625, 110 625, 125 620 C190 595, 250 560, 315 540 C340 532, 375 540, 395 555 C460 600, 545 625, 630 620 C730 615, 820 560, 875 510 Z"/>
                                        <Ellipse Fill="#0052D9" Width="42" Height="42" Canvas.Left="640" Canvas.Top="420"/>
                                        <Ellipse Fill="White" Width="14" Height="14" Canvas.Left="650" Canvas.Top="426"/>
                                    </Canvas>
                                </Viewbox>
                            </Border>
                            <TextBlock Text="DeskSeek"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="#0F172A"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Draggable center handle -->
                        <Grid Grid.Column="1" Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown"/>

                        <!-- Action Toolbar -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Pin Toggle Button -->
                            <Button x:Name="PinButton"
                                    Style="{StaticResource HeaderBtnStyle}"
                                    ToolTip="固定窗口 (Pin)"
                                    Click="PinButton_Click"
                                    Margin="2,0">
                                <TextBlock x:Name="PinIcon" Text="📌" FontSize="14" Foreground="#64748B"/>
                            </Button>

                            <!-- Zoom Presets Button -->
                            <Button x:Name="ZoomButton"
                                    Style="{StaticResource HeaderBtnStyle}"
                                    ToolTip="缩放比例 (点击切换 100% / 90% / 80%)"
                                    Click="ZoomButton_Click"
                                    Margin="2,0">
                                <TextBlock x:Name="ZoomText" Text="90%" FontSize="11" FontWeight="SemiBold" Foreground="#64748B"/>
                            </Button>

                            <!-- Refresh Button -->
                            <Button Style="{StaticResource HeaderBtnStyle}"
                                    ToolTip="刷新页面 (Refresh)"
                                    Click="RefreshButton_Click"
                                    Margin="2,0">
                                <TextBlock Text="🔄" FontSize="13" Foreground="#64748B"/>
                            </Button>

                            <!-- External Browser Button -->
                            <Button Style="{StaticResource HeaderBtnStyle}"
                                    ToolTip="在外部浏览器打开"
                                    Click="ExternalBrowserButton_Click"
                                    Margin="2,0">
                                <TextBlock Text="🌐" FontSize="13" Foreground="#64748B"/>
                            </Button>

                            <!-- Settings Button -->
                            <Button x:Name="SettingsButton"
                                    Style="{StaticResource HeaderBtnStyle}"
                                    ToolTip="偏好设置"
                                    Click="SettingsButton_Click"
                                    Margin="2,0">
                                <TextBlock Text="⚙️" FontSize="14" Foreground="#64748B"/>
                            </Button>

                            <!-- Close / Collapse Button -->
                            <Button Style="{StaticResource HeaderBtnStyle}"
                                    ToolTip="收起侧边栏"
                                    Click="CloseButton_Click"
                                    Margin="2,0">
                                <TextBlock Text="✕" FontSize="14" FontWeight="Bold" Foreground="#64748B"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Loading progress indicator -->
                <ProgressBar x:Name="LoadingBar"
                             Grid.Row="1"
                             Height="2.5"
                             IsIndeterminate="True"
                             Background="#F1F5F9"
                             Foreground="#0052D9"
                             BorderThickness="0"
                             Visibility="Visible"/>

                <!-- Content Area: WebView2 Host Area (Row 2 stops above Row 3 to protect bottom corners) -->
                <Border Grid.Row="2" Background="#FFFFFF">
                    <wv2:WebView2 x:Name="WebBrowser"/>
                </Border>

                <!-- Bottom Corner Shield: Guarantees bottom rounded corners are never occluded by WebView2 HWND -->
                <Border Grid.Row="3"
                        Background="#FFFFFF"
                        CornerRadius="0,0,16,16"/>

                <!-- Settings Flyout Overlay (covers Row 2 and Row 3 when active) -->
                <Border x:Name="SettingsOverlay"
                        Grid.Row="2"
                        Grid.RowSpan="2"
                        Background="#F8FAFC"
                        CornerRadius="0,0,16,16"
                        Visibility="Collapsed">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="46"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Settings Header Bar -->
                        <Border Grid.Row="0" Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                            <Grid Margin="12,0">
                                <Button x:Name="BackFromSettingsButton"
                                        HorizontalAlignment="Left"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Cursor="Hand"
                                        ToolTip="返回对话"
                                        Click="BackFromSettingsButton_Click">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="←" FontSize="14" FontWeight="Bold" Foreground="#0052D9" VerticalAlignment="Center"/>
                                        <TextBlock Text=" 返回对话" FontSize="13" FontWeight="SemiBold" Foreground="#0052D9" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                    </StackPanel>
                                </Button>

                                <TextBlock Text="偏好设置"
                                           FontSize="14"
                                           FontWeight="Bold"
                                           Foreground="#0F172A"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Settings Body -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="16,12">
                            <StackPanel>
                                <!-- Section 1: 基础与窗口 -->
                                <TextBlock Text="基础与窗口" FontSize="12" FontWeight="Bold" Foreground="#64748B" Margin="2,0,0,6"/>
                                <Border Background="#FFFFFF" CornerRadius="10" BorderBrush="#E2E8F0" BorderThickness="1" Padding="14,10" Margin="0,0,0,12">
                                    <StackPanel>
                                        <!-- Auto Start -->
                                        <Grid Margin="0,4">
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="开机自启" FontSize="13" FontWeight="Medium" Foreground="#1E293B"/>
                                                <TextBlock Text="系统开机后自动常驻系统托盘" FontSize="11" Foreground="#94A3B8"/>
                                            </StackPanel>
                                            <CheckBox x:Name="SettingAutoStart" HorizontalAlignment="Right" VerticalAlignment="Center" Click="SettingAutoStart_Click"/>
                                        </Grid>
                                        <Separator Background="#F1F5F9" Margin="0,8"/>

                                        <!-- Pin Mode -->
                                        <Grid Margin="0,4">
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="默认固定常驻" FontSize="13" FontWeight="Medium" Foreground="#1E293B"/>
                                                <TextBlock Text="点击其他窗口失焦时不自动收起" FontSize="11" Foreground="#94A3B8"/>
                                            </StackPanel>
                                            <CheckBox x:Name="SettingPin" HorizontalAlignment="Right" VerticalAlignment="Center" Click="SettingPin_Click"/>
                                        </Grid>
                                        <Separator Background="#F1F5F9" Margin="0,8"/>

                                        <!-- Auto Collapse -->
                                        <Grid Margin="0,4">
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="贴边闲置半隐藏" FontSize="13" FontWeight="Medium" Foreground="#1E293B"/>
                                                <TextBlock Text="悬浮球靠边闲置 2.5 秒后自动缩为极细边缘条" FontSize="11" Foreground="#94A3B8"/>
                                            </StackPanel>
                                            <CheckBox x:Name="SettingAutoCollapse" HorizontalAlignment="Right" VerticalAlignment="Center" Click="SettingAutoCollapse_Click"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Section 2: 快捷键与唤醒 -->
                                <TextBlock Text="快捷键与唤醒" FontSize="12" FontWeight="Bold" Foreground="#64748B" Margin="2,0,0,6"/>
                                <Border Background="#FFFFFF" CornerRadius="10" BorderBrush="#E2E8F0" BorderThickness="1" Padding="14,10" Margin="0,0,0,12">
                                    <Grid Margin="0,4">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="全局唤醒热键" FontSize="13" FontWeight="Medium" Foreground="#1E293B"/>
                                            <TextBlock Text="在任意应用前随时呼出/隐藏" FontSize="11" Foreground="#94A3B8"/>
                                        </StackPanel>
                                        <ComboBox x:Name="SettingHotkeyCombo"
                                                  HorizontalAlignment="Right"
                                                  VerticalAlignment="Center"
                                                  Width="110"
                                                  Height="28"
                                                  SelectionChanged="SettingHotkeyCombo_SelectionChanged">
                                            <ComboBoxItem Content="Alt+D"/>
                                            <ComboBoxItem Content="Alt+Space"/>
                                            <ComboBoxItem Content="Ctrl+Alt+D"/>
                                            <ComboBoxItem Content="Ctrl+Shift+D"/>
                                        </ComboBox>
                                    </Grid>
                                </Border>

                                <!-- Section 3: 性能与内存优化 -->
                                <TextBlock Text="性能与内存优化" FontSize="12" FontWeight="Bold" Foreground="#64748B" Margin="2,0,0,6"/>
                                <Border Background="#FFFFFF" CornerRadius="10" BorderBrush="#E2E8F0" BorderThickness="1" Padding="14,10" Margin="0,0,0,12">
                                    <Grid Margin="0,4">
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                                            <TextBlock Text="后台休眠省内存" FontSize="13" FontWeight="Medium" Foreground="#1E293B"/>
                                            <TextBlock Text="抽屉收起后自动挂起内核释放内存与 CPU" FontSize="11" Foreground="#94A3B8"/>
                                        </StackPanel>
                                        <CheckBox x:Name="SettingSuspend" HorizontalAlignment="Right" VerticalAlignment="Center" Click="SettingSuspend_Click"/>
                                    </Grid>
                                </Border>

                                <!-- Section 4: 尺寸与重置 -->
                                <TextBlock Text="尺寸与排版" FontSize="12" FontWeight="Bold" Foreground="#64748B" Margin="2,0,0,6"/>
                                <Border Background="#FFFFFF" CornerRadius="10" BorderBrush="#E2E8F0" BorderThickness="1" Padding="14,10" Margin="0,0,0,12">
                                    <Grid Margin="0,4">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="重置侧边栏尺寸" FontSize="13" FontWeight="Medium" Foreground="#1E293B"/>
                                            <TextBlock Text="恢复默认宽度 460px 及屏幕可用高度" FontSize="11" Foreground="#94A3B8"/>
                                        </StackPanel>
                                        <Button Content="重置尺寸"
                                                Padding="12,5"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                Background="#F1F5F9"
                                                BorderBrush="#CBD5E1"
                                                Cursor="Hand"
                                                Click="ResetSizeButton_Click"/>
                                    </Grid>
                                </Border>

                                <!-- Section 5: 数据与存储 -->
                                <TextBlock Text="数据与存储" FontSize="12" FontWeight="Bold" Foreground="#64748B" Margin="2,0,0,6"/>
                                <Border Background="#FFFFFF" CornerRadius="10" BorderBrush="#E2E8F0" BorderThickness="1" Padding="14,10" Margin="0,0,0,12">
                                    <Grid Margin="0,4">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="本地配置与数据目录" FontSize="13" FontWeight="Medium" Foreground="#1E293B"/>
                                            <TextBlock Text="保存登录 Cookie 及 JSON 配置文件" FontSize="11" Foreground="#94A3B8"/>
                                        </StackPanel>
                                        <Button Content="打开目录"
                                                Padding="12,5"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                Background="#F1F5F9"
                                                BorderBrush="#CBD5E1"
                                                Cursor="Hand"
                                                Click="OpenDataDirButton_Click"/>
                                    </Grid>
                                </Border>

                                <!-- Section 6: 关于 -->
                                <Border Background="Transparent" Padding="4,10" HorizontalAlignment="Center">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="DeskSeek v1.1.0" FontSize="12" FontWeight="SemiBold" Foreground="#64748B" HorizontalAlignment="Center"/>
                                        <TextBlock Text="极简轻量 · 官方直连 · 原生体验" FontSize="11" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- Disclaimer Overlay (Shown only on first launch, covers Row 2 and Row 3) -->
                <Border x:Name="DisclaimerOverlay"
                        Grid.Row="2"
                        Grid.RowSpan="2"
                        Background="#FFFFFF"
                        CornerRadius="0,0,16,16"
                        Visibility="Collapsed">
                    <Grid Margin="24,18,24,20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Header with Icon and Title -->
                        <StackPanel Grid.Row="0" Margin="0,0,0,14">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="38" Height="38" CornerRadius="19" Background="#EFF6FF" Margin="0,0,10,0">
                                    <TextBlock Text="🛡️" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="免责声明与服务协议" FontSize="16" FontWeight="Bold" Foreground="#0F172A"/>
                                    <TextBlock Text="首次使用请仔细阅读并知悉以下规范" FontSize="11" Foreground="#64748B" Margin="0,2,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>

                        <!-- Scrollable Terms Content -->
                        <Border Grid.Row="1"
                                Background="#F8FAFC"
                                BorderBrush="#E2E8F0"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="16,14">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel>
                                    <TextBlock Text="一、第三方非官方声明" FontSize="12.5" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,4"/>
                                    <TextBlock Text="DeskSeek 为独立的开源第三方轻量桌面辅助客户端，其核心功能为提供贴边吸附与便捷唤起的 DeepSeek 网页版（chat.deepseek.com）容器。DeskSeek 与 DeepSeek（杭州深度求索人工智能基础技术研究有限公司）官方不存在任何商业合作、投资或运营隶属关系。"
                                               FontSize="11.5" Foreground="#475569" TextWrapping="Wrap" LineHeight="18" Margin="0,0,0,12"/>

                                    <TextBlock Text="二、隐私安全与数据传输" FontSize="12.5" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,4"/>
                                    <TextBlock Text="本软件坚守纯粹轻量原则，完全依托系统原生 WebView2 运行。软件本身绝不拦截、窃取、存储或上传您的任何 DeepSeek 账户、密码、Token、Cookies 或对话记录。所有通信均直接在您的本地设备与 DeepSeek 官方服务器间通过 HTTPS 加密进行。"
                                               FontSize="11.5" Foreground="#475569" TextWrapping="Wrap" LineHeight="18" Margin="0,0,0,12"/>

                                    <TextBlock Text="三、使用规范与合规责任" FontSize="12.5" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,4"/>
                                    <TextBlock Text="用户在使用 DeskSeek 及 DeepSeek 网页版时，应自觉遵守国家法律法规以及 DeepSeek 官方制定的《服务条款》和《用户协议》。使用者不得利用本软件从事任何危害网络安全、侵犯他人隐私或违反相关法律规定的活动。"
                                               FontSize="11.5" Foreground="#475569" TextWrapping="Wrap" LineHeight="18" Margin="0,0,0,12"/>

                                    <TextBlock Text="四、免责条款" FontSize="12.5" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,4"/>
                                    <TextBlock Text="本软件遵循 Apache-2.0 开源许可协议提供，按“现状”（AS-IS）分发，不提供任何形式的明示或暗示担保。因网络环境不稳定、DeepSeek 官方网页端架构调整或不可抗力导致的服务中断或异常，本软件开发者不承担任何附带或连带法律责任。"
                                               FontSize="11.5" Foreground="#475569" TextWrapping="Wrap" LineHeight="18"/>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>

                        <!-- Actions Area -->
                        <StackPanel Grid.Row="2" Margin="0,14,0,0">
                            <!-- CheckBox -->
                            <CheckBox x:Name="DisclaimerCheckBox"
                                      IsEnabled="False"
                                      Margin="2,0,0,12"
                                      Cursor="Hand"
                                      Click="DisclaimerCheckBox_Click">
                                <TextBlock Text="我已充分阅读、理解并同意上述免责声明与服务协议"
                                           FontSize="12"
                                           FontWeight="Medium"
                                           Foreground="#334155"
                                           VerticalAlignment="Center"/>
                            </CheckBox>

                            <!-- Confirm Button -->
                            <Button x:Name="DisclaimerAgreeButton"
                                    Height="40"
                                    IsEnabled="False"
                                    Background="#94A3B8"
                                    Foreground="#FFFFFF"
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    BorderThickness="0"
                                    Cursor="No"
                                    Click="DisclaimerAgreeButton_Click">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="8"/>
                                    </Style>
                                </Button.Resources>
                                <TextBlock x:Name="DisclaimerButtonText"
                                           Text="请先阅读免责声明 (3s)"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Left Resize Grip (Active when docked to Right) -->
                <Border x:Name="LeftResizeGrip"
                        Grid.RowSpan="4"
                        Width="8"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Stretch"
                        Background="Transparent"
                        Cursor="SizeWE"
                        MouseEnter="ResizeGrip_MouseEnter"
                        MouseLeave="ResizeGrip_MouseLeave"
                        MouseLeftButtonDown="ResizeGrip_MouseLeftButtonDown"
                        MouseLeftButtonUp="ResizeGrip_MouseLeftButtonUp"
                        MouseMove="ResizeGrip_MouseMove">
                    <Border x:Name="LeftResizeBar"
                            Width="3" Height="36"
                            CornerRadius="1.5"
                            Background="#3B82F6"
                            Opacity="0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>
                </Border>

                <!-- Right Resize Grip (Active when docked to Left) -->
                <Border x:Name="RightResizeGrip"
                        Grid.RowSpan="4"
                        Width="8"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Stretch"
                        Background="Transparent"
                        Cursor="SizeWE"
                        Visibility="Collapsed"
                        MouseEnter="ResizeGrip_MouseEnter"
                        MouseLeave="ResizeGrip_MouseLeave"
                        MouseLeftButtonDown="ResizeGrip_MouseLeftButtonDown"
                        MouseLeftButtonUp="ResizeGrip_MouseLeftButtonUp"
                        MouseMove="ResizeGrip_MouseMove">
                    <Border x:Name="RightResizeBar"
                            Width="3" Height="36"
                            CornerRadius="1.5"
                            Background="#3B82F6"
                            Opacity="0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>
                </Border>

                <!-- Bottom Resize Grip (for height adjustment) -->
                <Border x:Name="BottomResizeGrip"
                        Grid.Row="3"
                        Height="10"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Bottom"
                        Background="Transparent"
                        Cursor="SizeNS"
                        MouseLeftButtonDown="BottomResizeGrip_MouseLeftButtonDown"
                        MouseLeftButtonUp="BottomResizeGrip_MouseLeftButtonUp"
                        MouseMove="BottomResizeGrip_MouseMove"/>
            </Grid>
        </Border>
    </Grid>
</Window>
