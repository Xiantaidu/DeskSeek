<Window x:Class="DeskSeek.Views.DrawerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:controls="clr-namespace:DeskSeek.Views.Controls"
        Title="DeskSeek"
        Width="460" Height="780"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize">

    <Window.Resources>
        <Style x:Key="HeaderBtnStyle" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="8" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#15000000"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#25000000"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Main Container: Crisp Modern Border and Rounded Corners -->
    <Grid Margin="6">
        <Border x:Name="MainCard"
                CornerRadius="16"
                Background="#FFFFFF"
                BorderBrush="#CBD5E1"
                BorderThickness="1.2"
                RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <TranslateTransform x:Name="CardTranslate" X="0" Y="0"/>
            </Border.RenderTransform>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="50"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="20"/>
                </Grid.RowDefinitions>

                <!-- Header Bar -->
                <Border Grid.Row="0"
                        Background="#F8FAFC"
                        CornerRadius="16,16,0,0"
                        BorderBrush="#E2E8F0"
                        BorderThickness="0,0,0,1">
                    <Grid Margin="14,0,10,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Brand Logo & Name -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="26" Height="26" CornerRadius="13" Background="#0052D9" Margin="0,0,8,0">
                                <TextBlock Text="D" Foreground="White" FontWeight="Bold" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="DeskSeek" FontSize="14" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Draggable center handle -->
                        <Grid Grid.Column="1" Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown"/>

                        <!-- Action Toolbar -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Pin Mode Button (Supports 3 Modes: PinnedTopmost, PinnedNormal, AutoHide) -->
                            <Button x:Name="PinButton"
                                    Style="{StaticResource HeaderBtnStyle}"
                                    ToolTip="常驻模式 (点击切换)"
                                    Click="PinButton_Click"
                                    PreviewMouseRightButtonDown="PinButton_PreviewMouseRightButtonDown"
                                    Margin="2,0">
                                <Button.ContextMenu>
                                    <ContextMenu x:Name="PinContextMenu">
                                        <MenuItem x:Name="PinMenuTopmost" Header="常驻且置顶" Click="PinMenuTopmost_Click"/>
                                        <MenuItem x:Name="PinMenuNormal" Header="常驻但不置顶" Click="PinMenuNormal_Click"/>
                                        <MenuItem x:Name="PinMenuAutoHide" Header="失焦自动收起" Click="PinMenuAutoHide_Click"/>
                                    </ContextMenu>
                                </Button.ContextMenu>
                                <Grid Width="28" Height="28">
                                    <TextBlock x:Name="PinIcon"
                                               Text="📌"
                                               FontSize="13"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                    <!-- Mode indicator badge -->
                                    <Border x:Name="PinBadge"
                                            CornerRadius="3"
                                            Padding="2,0"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Bottom"
                                            Margin="0,0,-1,-1"
                                            Visibility="Collapsed">
                                        <TextBlock x:Name="PinBadgeText" Text="顶" FontSize="7.5" FontWeight="Bold" Foreground="#FFFFFF"/>
                                    </Border>
                                </Grid>
                            </Button>

                            <!-- Zoom Presets Button -->
                            <Button x:Name="ZoomButton"
                                    Style="{StaticResource HeaderBtnStyle}"
                                    ToolTip="缩放比例 (点击切换 100% / 90% / 80%)"
                                    Click="ZoomButton_Click"
                                    Margin="2,0">
                                <TextBlock x:Name="ZoomText" Text="90%" FontSize="11" FontWeight="SemiBold" Foreground="#64748B"/>
                            </Button>

                            <!-- Refresh Button -->
                            <Button Style="{StaticResource HeaderBtnStyle}"
                                    ToolTip="刷新页面 (Refresh)"
                                    Click="RefreshButton_Click"
                                    Margin="2,0">
                                <TextBlock Text="🔄" FontSize="13" Foreground="#64748B"/>
                            </Button>

                            <!-- Open in External Browser Button -->
                            <Button Style="{StaticResource HeaderBtnStyle}"
                                    ToolTip="在默认浏览器中打开"
                                    Click="ExternalBrowserButton_Click"
                                    Margin="2,0">
                                <TextBlock Text="↗" FontSize="14" FontWeight="Bold" Foreground="#64748B"/>
                            </Button>

                            <!-- Settings Button -->
                            <Button x:Name="SettingsButton"
                                    Style="{StaticResource HeaderBtnStyle}"
                                    ToolTip="偏好设置"
                                    Click="SettingsButton_Click"
                                    Margin="2,0">
                                <TextBlock Text="⚙" FontSize="14" Foreground="#64748B"/>
                            </Button>

                            <!-- Close / Hide Button -->
                            <Button Style="{StaticResource HeaderBtnStyle}"
                                    ToolTip="收起抽屉"
                                    Click="CloseButton_Click"
                                    Margin="2,0">
                                <TextBlock Text="✕" FontSize="12" FontWeight="SemiBold" Foreground="#64748B"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Thin Modern Loading Bar -->
                <ProgressBar x:Name="LoadingBar"
                             Grid.Row="1"
                             Height="2"
                             IsIndeterminate="True"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="#0052D9"
                             Visibility="Collapsed"/>

                <!-- Live WebView2 Browser Host -->
                <wv2:WebView2 x:Name="WebBrowser"
                              Grid.Row="2"
                              Margin="8,0,0,0"/>

                <!-- Snapshot Image (Used during fade in/out animations to guarantee 100% lockstep frame sync) -->
                <Image x:Name="WebSnapshotImage"
                       Grid.Row="2"
                       Margin="8,0,0,0"
                       Stretch="Fill"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       Visibility="Collapsed"/>

                <!-- Bottom Footer Area -->
                <Border Grid.Row="3"
                        Background="#FFFFFF"
                        CornerRadius="0,0,16,16"/>

                <!-- Modular Settings Flyout Overlay -->
                <controls:SettingsOverlay x:Name="SettingsControl"
                                          Grid.Row="2"
                                          Grid.RowSpan="2"
                                          Visibility="Collapsed"/>

                <!-- Modular Disclaimer Overlay (Shown on first launch) -->
                <controls:DisclaimerOverlay x:Name="DisclaimerControl"
                                            Grid.Row="2"
                                            Grid.RowSpan="2"
                                            Visibility="Collapsed"/>

                <!-- Left Resize Grip (Active when docked to Right, 18px wide hit-test area) -->
                <Border x:Name="LeftResizeGrip"
                        Grid.RowSpan="4"
                        Width="18"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Stretch"
                        Background="Transparent"
                        Cursor="SizeWE">
                    <Border x:Name="LeftResizeBar"
                            Width="4" Height="48"
                            CornerRadius="2"
                            Background="#CBD5E1"
                            Opacity="0.5"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>
                </Border>

                <!-- Right Resize Grip (Active when docked to Left, 18px wide hit-test area) -->
                <Border x:Name="RightResizeGrip"
                        Grid.RowSpan="4"
                        Width="18"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Stretch"
                        Background="Transparent"
                        Cursor="SizeWE"
                        Visibility="Collapsed">
                    <Border x:Name="RightResizeBar"
                            Width="4" Height="48"
                            CornerRadius="2"
                            Background="#CBD5E1"
                            Opacity="0.5"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>
                </Border>

                <!-- Bottom Resize Grip (Entire 20px bottom row hit-test area with pill handle) -->
                <Border x:Name="BottomResizeGrip"
                        Grid.Row="3"
                        Height="20"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Bottom"
                        Background="Transparent"
                        Cursor="SizeNS">
                    <Border x:Name="BottomResizeBar"
                            Width="48" Height="4"
                            CornerRadius="2"
                            Background="#CBD5E1"
                            Opacity="0.5"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
